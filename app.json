{
  "expo": {
    "name": "CopyThat",
    "slug": "copythat",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "copythat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "se.jawel.copythat",
      "buildNumber": "8",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan documents to extract text via AI",
        "NSPhotoLibraryUsageDescription": "Import existing photos to scan text",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.jawel.copythat",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4E9D8"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4E9D8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan documents to extract text via AI"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import existing photos to scan text"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
