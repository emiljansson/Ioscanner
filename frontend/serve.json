{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/doc/:id", "destination": "/doc/[id].html" },
    { "source": "/preview/:id", "destination": "/preview/[id].html" }
  ],
  "headers": [
    { "source": "/_expo/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
